{
  "name": "claude-mri",
  "version": "0.1.0",
  "description": "Scan a machine for Claude Code configuration and explore it as an interactive, Miro-style graph.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "claude-mri": "dist/server/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.16"
  },
  "keywords": [
    "claude-code",
    "configuration",
    "visualization",
    "graph",
    "mcp",
    "plugins",
    "skills",
    "hooks"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.server.json && vite build && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "demo": "node scripts/make-demo.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "dompurify": "^3.4.16",
    "elkjs": "^0.12.0",
    "jsdom": "^30.1.2",
    "marked": "^18.1.0",
    "oxlint": "^1.87.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
